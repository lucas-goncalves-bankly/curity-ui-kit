#set($_errorClassUsername = "")
#set($_errorClassPassword = "")
#if($logo_white_path && !$logo_path)
	#set($logo_path = $logo_white_path)
#end

#if($_postBack && $_postBack["userName"])
	#set($userNameValue = $_postBack["userName"])
#elseif($_username)
	#set($userNameValue = $_username)
#end

#set ($page_symbol = $page_symbol_authenticate_totp)

#define($_body)
#parse("fragments/credential-operation-details")

<div class="login-container">
	<div class="login-left">
		<div class="login-logo-custom">
			#if($logo_path)
				<img src="$logo_path" alt="Logo" style="max-width: 200px; max-height: 100px;" />
			#end
		</div>

		<form method="post" class="login-form">
			#if ($_errors)
				#set($_errorClass = "is-error is-error-danger")
			#end

			<!--<h1 class="center">#message("authenticator.totp.authenticate.view.title1")</h1>-->

			<div class="form-field">
				<label class="$!_errorClass">#message("authenticator.totp.authenticate.view.username")</label>
				<input type="text" name="userName" id="userName" class="block full-width mb1 field-light $!_errorClass"
					autofocus required value="$!userNameValue" autocapitalize="none">
				<i class="form-field-icon icon ion-ios-person"></i>
			</div>

			<button type="submit" class="button button-fullwidth $!button_color mt2">#message(
				"authenticator.totp.authenticate.view.challenge")</button>

			#if ($_allowRegistrationDuringLogin && $_registrationEndpoint)
				<div class="mt3 clearfix">
					<div class="center py2 login-actions">
					<a href="$_registrationEndpoint">#message("authenticator.totp.authenticate.view.register")</a>
					</div>
				</div>
			#end
		</form>

		<div class="login-footer">
			<span>&copy; Bankly</span>&nbsp;&nbsp;<span>Contato</span>&nbsp;&nbsp;<span>Privacidade e termos</span>&nbsp;&nbsp;<a href="https://portal.staging.bankly.com.br/faq" target="_blank" rel="noopener noreferrer">FAQ</a>
		</div>
	</div>

	<div class="login-right">
		<h2>Entre com sua conta<br>para validar o<br>TOTP.</h2>
	</div>
</div>

#end

#parse("layouts/default")